**/__pycache__/
test
dest
*.log
*.bak
*.tmp
*.swp
*.swo
*~
.DS_Store
._*

# Ignore installed binaries and symlinks in .local/bin
.local/bin/agy*
.local/bin/claude
.local/bin/codex
.local/bin/hyprshell

# Tmux plugins managed by TPM
.config/tmux/plugins/*
!.config/tmux/plugins/.gitkeep

# Systemd generated targets and wants
.config/systemd/user/*.wants/

# Rendered by Noctalia's theme templates on every palette change
.config/hypr-noctalia/noctalia.lua
.config/hypr-noctalia/hyprtoolkit.conf
