#!/bin/bash
# Screenshot helper.
#   screenshot            capture the whole output
#   screenshot --select   capture a region (grim + slurp)
#   screenshot --edit     capture a region and annotate it (flameshot)
#
# --select deliberately uses grim+slurp rather than flameshot. flameshot's
# overlay opens on Hyprland but returns an empty capture, and the window rule
# for class "flameshot" forces it fullscreen, so a failure fills the screen.
# grim/slurp are the native wlroots tools and are used by --select for that
# reason; flameshot is still available through --edit when annotation is
# wanted.

APP_NAME="screenshot"

# $XDG_PICTURES_DIR is exported by hypr/config/env.lua from user-dirs.dirs.
# Fall back to xdg-user-dir, then to ~/Pictures, so the script also works
# when run from a plain shell that has no such variable.
PICTURES="${XDG_PICTURES_DIR:-$(xdg-user-dir PICTURES 2>/dev/null)}"
PICTURES="${PICTURES:-$HOME/Pictures}"

DIR="$PICTURES/screenshots"
FILE="$DIR/$(date +"%Y-%m-%d_%H-%M-%S").png"

# grim/flameshot will not create missing parent directories
if ! mkdir -p "$DIR"; then
    notify-send --app-name "$APP_NAME" --icon dialog-error \
                "Screenshot failed" "Could not create $DIR"
    exit 1
fi

case "$1" in
    --select)
        # slurp exits non-zero when the selection is cancelled
        GEOMETRY=$(slurp) || exit 0
        grim -g "$GEOMETRY" "$FILE"
        STATUS=$?
        ;;

    --edit)
        if ! command -v flameshot >/dev/null 2>&1; then
            notify-send --app-name "$APP_NAME" --icon dialog-error \
                        "Cannot annotate" "flameshot is not installed"
            exit 1
        fi

        flameshot gui --path "$FILE"
        STATUS=$?
        ;;

    *)
        grim "$FILE"
        STATUS=$?
        ;;
esac

# A cancelled capture can exit 0 while writing nothing, so check the file too
if [[ $STATUS -ne 0 ]] || [[ ! -s "$FILE" ]]; then
    rm -f "$FILE"
    exit "$STATUS"
fi

# Without an explicit type the PNG lands on the clipboard as text
wl-copy --type image/png < "$FILE"

notify-send --app-name "$APP_NAME" \
            --icon "$FILE" \
            "New screenshot" "$FILE"
