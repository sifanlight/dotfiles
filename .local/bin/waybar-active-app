#!/usr/bin/env python3
import os
import sys
import json
import socket
import subprocess

ICON_MAP = {
    "ghostty": "󰞷",
    "firefox": "󰈹",
    "helium": "󰊯",
    "zotero": "󱉟",
    "obsidian": "󱓧",
    "code": "󰨞",
    "vscode": "󰨞",
    "vscodium": "󰨞",
    "thunar": "󰉋",
    "dolphin": "󰉋",
    "chrome": "",
    "chromium": "",
    "spotify": "󰓇",
    "discord": "󰙯",
    "slack": "󰒱",
    "kitty": "󰄛",
    "alacritty": "",
    "steam": "󰓓",
    "mpv": "",
    "gwenview": "󰋩",
    "inkscape": "",
    "okular": "󰈦",
    "pavucontrol": "󰕾",
    "blueman": "󰂯",
    "nwg-look": "",
    "qt6ct": "",
}

def get_icon(cls_name: str) -> str:
    if not cls_name:
        return "󰖲"
    cls_lower = cls_name.lower()
    for key, icon in ICON_MAP.items():
        if key in cls_lower:
            return icon
    return "󰖲"

def get_active_window():
    try:
        res = subprocess.run(
            ["hyprctl", "activewindow", "-j"],
            capture_output=True,
            text=True,
            check=True
        )
        data = json.loads(res.stdout)
        if not data or not isinstance(data, dict):
            return {"text": "󰖲", "tooltip": "Desktop", "class": "empty"}
        cls = data.get("class", "")
        title = data.get("title", "")
        icon = get_icon(cls)
        tooltip = f"{cls}: {title}" if cls and title else (cls or title or "Desktop")
        return {"text": icon, "tooltip": tooltip, "class": cls.lower()}
    except Exception:
        return {"text": "󰖲", "tooltip": "Desktop", "class": "empty"}

def emit():
    out = get_active_window()
    print(json.dumps(out), flush=True)

def main():
    emit()
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    sock_path = f"{xdg_runtime}/hypr/{sig}/.socket2.sock"

    if not os.path.exists(sock_path):
        import time
        while True:
            time.sleep(2)
            emit()
        return

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(sock_path)
        buffer = ""
        while True:
            chunk = s.recv(1024).decode("utf-8", errors="ignore")
            if not chunk:
                break
            buffer += chunk
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                if any(line.startswith(prefix) for prefix in ("activewindow>>", "activewindowv2>>", "workspace>>", "focusedmon>>", "closewindow>>")):
                    emit()

if __name__ == "__main__":
    main()
