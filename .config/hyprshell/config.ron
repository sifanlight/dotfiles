// Edit with `hyprshell config edit`
(
    version: 4,
    windows: (
        scale: 8.5,
        items_per_row: 5,
        overview: (
            modifier: "super",
            key: "Super_L",
            top_offset: 430,
            filter_by: [],
            exclude_workspaces: "special:.*",
            launcher: (
                launch_modifier: "ctrl",
                width: 650,
                max_items: 5,
                show_when_empty: true,
                plugins: (
                    applications: (
                        run_cache_weeks: 8,
                        show_execs: true,
                        show_actions_submenu: true,
                    ),
                    terminal: (),
                    websearch: (
                        engines: [
                            (
                                url: "https://www.google.com/search?q={}",
                                name: "Google",
                                key: 'g',
                            ),
                            (
                                url: "https://en.wikipedia.org/wiki/Special:Search?search={}",
                                name: "Wikipedia",
                                key: 'w',
                            ),
                        ],
                    ),
                    calc: (),
                    path: (),
                    actions: (
                        actions: [
                            lock_screen,
                            hibernate,
                            logout,
                            reboot,
                            shutdown,
                            suspend,
                        ],
                    ),
                ),
            ),
        ),
        switch: (
            modifier: "alt",
            key: "Tab",
            filter_by: [current_monitor],
            switch_workspaces: true,
            exclude_workspaces: "",
            kill_key: 'q',
        ),
    ),
)
