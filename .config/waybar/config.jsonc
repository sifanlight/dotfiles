{
    "layer": "top",
    "position": "left",
    "width": 47,
    "exclusive": true,
    "spacing": 4,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/active-app",
        "hyprland/window"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "tray",
        "group/system",
        "clock"
    ],

    "include": [ "~/.config/waybar/modules.jsonc" ]
}
