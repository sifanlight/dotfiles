{
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": true,
        "tooltip-format": "Application Launcher (rofi)",
        "on-click": "~/.config/rofi/bin/drun &",
        "cursor": true
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "persistent-workspaces": { "*": 5 },
        "cursor": true
    },

    "custom/active-app": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-active-app",
        "tooltip": true
    },

    "hyprland/window": {
        "format": "",
        "icon": false
    },

    "mpris": {
        "format": "{player_icon} {artist} — {title}",
        "format-paused": "{status_icon} <i>{artist} — {title}</i>",
        "format-stopped": "",
        "max-length": 26,
        "rotate": 270,
        "player-icons": {
            "default": "",
            "spotify": "󰓇"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "tooltip-format": "Media: {player}\nArtist: {artist}\nTitle: {title}\nAlbum: {album}",
        "tooltip-format-paused": "Paused: {artist} — {title}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    "tray": {
        "icon-size": 12,
        "spacing": 4,
        "cursor": true
    },

    "group/system": {
        "orientation": "vertical",
        "modules": [
            "pulseaudio",
            "network",
            "bluetooth",
            "power-profiles-daemon",
            "battery",
            "custom/notification"
        ]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "󰂰",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "hyprctl eval \"hl.exec_cmd('pavucontrol')\"",
        "tooltip-format": "Volume: {volume}%\n{desc}"
    },

    "network": {
        "interval": 5,
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤭",
        "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%)\nIP: {ipaddr}\n▲ {bandwidthUpBytes}   ▼ {bandwidthDownBytes}",
        "tooltip-format-ethernet": "Ethernet: {ipaddr}\n▲ {bandwidthUpBytes}   ▼ {bandwidthDownBytes}",
        "tooltip-format-disconnected": "Network Disconnected",
        "on-click": "hyprctl eval \"hl.exec_cmd('nm-connection-editor')\"",
        "on-click-right": "hyprctl eval \"hl.exec_cmd('ghostty -e nmtui')\""
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": "Bluetooth: {status}\n{num_connections} connected",
        "tooltip-format-connected": "Bluetooth: {device_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t(󰁹 {device_battery_percentage}%)",
        "on-click": "~/.local/bin/toggle_bluetooth &",
        "on-click-right": "hyprctl eval \"hl.exec_cmd('blueman-manager')\""
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power Profile: {profile}",
        "format-icons": {
            "performance": "",
            "balanced": "",
            "power-saver": ""
        },
        "on-click": "~/.local/bin/powerprofile next"
    },

    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "",
        "format-plugged": "󰚥",
        "format-full": "󰁹",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Battery: {capacity}%\nState: {time}"
    },

    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Notification Center",
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󱅫",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󱅫",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "clock": {
        "format": "{:%b\n%d\n──\n%H\n%M}",
        "format-alt": "{:%a\n%d\n──\n%H\n%M\n%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click-right": "hyprctl eval \"hl.exec_cmd('ghostty --class=peaclock -e peaclock')\"",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#bb9af7'><b>{}</b></span>",
                "days":     "<span color='#c0caf5'><b>{}</b></span>",
                "weeks":    "<span color='#7aa2f7'><b>W{}</b></span>",
                "weekdays": "<span color='#e0af68'><b>{}</b></span>",
                "today":    "<span color='#f7768e'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
